# Copy this file to `.env` (which is gitignored) and set real values before running
# `docker compose up`. NEVER commit real secrets.

# JWT signing keys — REQUIRED. Tokens are RS256: auth-service signs with the private key and
# every service verifies with the public one. A public key cannot create a signature, so a
# compromise of ride/food/wallet/gateway can no longer be used to mint tokens.
#
# Both values are base64 of the DER bytes, on ONE line (PEM is multi-line and does not survive
# .env / Compose interpolation reliably). Generate a pair with:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER -out priv.der
#   openssl pkcs8 -topk8 -nocrypt -inform DER -in priv.der -outform DER -out priv_pk8.der
#   openssl rsa -inform DER -in priv.der -pubout -outform DER -out pub.der
#   base64 -w0 priv_pk8.der   # JWT_PRIVATE_KEY
#   base64 -w0 pub.der        # JWT_PUBLIC_KEY
#
# The pkcs8 step is not optional: openssl's DER output for RSA is PKCS#1, and Java's KeyFactory
# rejects it with "algid parse error, not a sequence".
#
# Keep the private key out of anything shared — it is the one value that can mint an admin session.
JWT_PRIVATE_KEY=CHANGE_ME_base64_of_pkcs8_der_private_key
JWT_PUBLIC_KEY=CHANGE_ME_base64_of_x509_der_public_key

# Retired public keys, comma-separated — auth-service only, normally empty.
# Set during a key rotation so tokens signed with the outgoing key keep verifying until they
# expire. Verifiers fetch the whole set from GET /auth/.well-known/jwks.json, which is why a
# rotation restarts auth-service alone. Procedure: docs/DEPLOYMENT.md section 3.
JWT_PREVIOUS_PUBLIC_KEYS=

# Shared secret for internal service-to-service settlement calls (wallet /commission, /settle).
# Generate one, e.g.:  openssl rand -base64 32
INTERNAL_KEY=CHANGE_ME_internal_service_key

# Paystack SECRET key — backend only. Blank/omitted = mock mode (no real charges).
PAYSTACK_SECRET_KEY=

# Google Maps server key — backend only (Directions/Places/Geocoding).
GOOGLE_MAPS_SERVER_KEY=

# Super-admin bootstrap password.
SUPERADMIN_PASSWORD=

# Gmail SMTP (email verification codes)
MAIL_USERNAME=
MAIL_APP_PASSWORD=

# SMS OTP — provider: africastalking | twilio. Blank = OTP is logged.
SMS_PROVIDER=africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
