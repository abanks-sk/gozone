# Copy this file to `.env` (which is gitignored) and set real values before running
# `docker compose up`. NEVER commit real secrets.

# JWT signing keys — REQUIRED. Tokens are RS256: auth-service signs with the private key and
# every service verifies with the public one. A public key cannot create a signature, so a
# compromise of ride/food/wallet/gateway can no longer be used to mint tokens.
#
# Both values are base64 of the DER bytes, on ONE line (PEM is multi-line and does not survive
# .env / Compose interpolation reliably). Generate a pair with:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER -out priv.der
#   openssl pkcs8 -topk8 -nocrypt -inform DER -in priv.der -outform DER -out priv_pk8.der
#   openssl rsa -inform DER -in priv.der -pubout -outform DER -out pub.der
#   base64 -w0 priv_pk8.der   # JWT_PRIVATE_KEY
#   base64 -w0 pub.der        # JWT_PUBLIC_KEY
#
# The pkcs8 step is not optional: openssl's DER output for RSA is PKCS#1, and Java's KeyFactory
# rejects it with "algid parse error, not a sequence".
#
# Keep the private key out of anything shared — it is the one value that can mint an admin session.
JWT_PRIVATE_KEY=CHANGE_ME_base64_of_pkcs8_der_private_key
JWT_PUBLIC_KEY=CHANGE_ME_base64_of_x509_der_public_key

# Retired public keys, comma-separated — auth-service only, normally empty.
# Set during a key rotation so tokens signed with the outgoing key keep verifying until they
# expire. Verifiers fetch the whole set from GET /auth/.well-known/jwks.json, which is why a
# rotation restarts auth-service alone. Procedure: docs/DEPLOYMENT.md section 3.
JWT_PREVIOUS_PUBLIC_KEYS=

# Shared secret for internal service-to-service settlement calls (wallet /commission, /settle).
# Generate one, e.g.:  openssl rand -base64 32
INTERNAL_KEY=CHANGE_ME_internal_service_key

# Paystack SECRET key — backend only. Blank/omitted = mock mode (no real charges).
PAYSTACK_SECRET_KEY=

# Google Maps server key — backend only (Directions/Places/Geocoding).
GOOGLE_MAPS_SERVER_KEY=

# Super-admin bootstrap password.
SUPERADMIN_PASSWORD=

# Gmail SMTP (email verification codes)

# SMS OTP via Termii. Blank API key = the OTP is logged instead of sent.
# Termii — the only SMS provider. The sender ID must be one Termii has APPROVED;
# until then sends are rejected and the OTP falls back to the service log.
TERMII_API_KEY=
TERMII_SENDER_ID=GoZone
TERMII_CHANNEL=generic

# ── Deployment (Railway) ─────────────────────────────────────────────────────
# PORT is injected by the platform — do not set it. Every service reads ${PORT:<default>}.
# Full per-service checklist: docs/RAILWAY.md

# Database. On Railway each service points DB_NAME at its own logical database;
# Railway's managed Postgres only creates ONE, so the other three are created by hand.
DB_HOST=localhost
DB_PORT=5432
DB_USER=gozone
DB_PASS=gozone
# DB_NAME differs per service: auth_db | ride_db | food_db | wallet_db

# Inter-service URLs. Localhost defaults suit docker-compose; on Railway these become
# http://<service>.railway.internal:<that service's PORT>.
AUTH_SERVICE_URL=
RIDE_SERVICE_URL=
FOOD_SERVICE_URL=
WALLET_SERVICE_URL=
NOTIFY_URL=
JWKS_URL=

# JWT. Public key + issuer + audience go on EVERY service; the private key on auth-service ONLY.
JWT_ISSUER=gozone-auth
JWT_AUDIENCE=gozone-apps

# Uploads must live on a mounted volume, or every driver's KYC documents are
# destroyed on the next deploy.
UPLOAD_DIR=/var/gozone/uploads

# ⚠️ Logs become credentials when this is true — anyone who can read them can sign in as
# anyone. Deliberately true while the Termii sender ID is pending approval.
OTP_LOG_CODES=true

# Push notifications (wallet-service).
EXPO_ACCESS_TOKEN=

# Brevo (transactional email). SMTP was dropped — PaaS hosts block outbound mail ports.
# The sender must be an address/domain verified in your Brevo account.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# SMS fallback sender (alphanumeric, max 11 chars). Same BREVO_API_KEY as email.
BREVO_SMS_SENDER=GoZone
MAIL_FROM_NAME=GoZone

# Arkesel — primary SMS provider (Ghana-based, so local numbers route domestically).
# Sender must be an ID Arkesel has approved; alphanumeric, max 11 chars.
ARKESEL_API_KEY=
ARKESEL_SENDER=GoZone
