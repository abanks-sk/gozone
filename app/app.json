{
  "expo": {
    "name": "GoZone",
    "slug": "gozone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d6e3a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gozone.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1d6e3a"
      },
      "package": "com.gozone.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1d6e3a"
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "http://192.168.1.100:8080"
    }
  }
}
