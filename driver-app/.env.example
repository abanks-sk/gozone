# Copy this file to `.env` (which is gitignored) and fill in the value.
# The Google Maps key is injected by app.config.js — never hardcode it in app.json.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth Web client ID (Google Cloud Console → Credentials).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
