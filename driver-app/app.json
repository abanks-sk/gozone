{
  "expo": {
    "name": "GoZone Driver",
    "slug": "gozone-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B18"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gozone.driver"
    },
    "android": {
      "package": "com.gozone.driver",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2563EB"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "GoZone needs your photos so you can attach your licence and vehicle documents.",
          "cameraPermission": "GoZone needs the camera so you can photograph your licence, vehicle and yourself for verification."
        }
      ]
    ],
    "scheme": "gozonedriver"
  }
}
